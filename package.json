{
  "name": "codelens-ai",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Windows floating assistant for Chinese code explanations",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/lrfovo/CodeLens-AI.git" },
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-icon.ps1 && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.codelensai.desktop",
    "productName": "CodeLens AI",
    "directories": { "output": "release/0.4.0" },
    "files": ["dist/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
